# Ne jamais placer de valeur réelle dans ce fichier versionné.
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
POSTGRES_PASSWORD=
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_JWT_SECRET=
NATIONAL_SYNC_START_DATE=2000-01-01
# Développement local : 11 (Île-de-France). Production nationale : laisser vide.
SYNC_REGION_CODES=11
# Port local uniquement : 8501 en développement ; choisir un port libre sur OVH.
STREAMLIT_HOST_PORT=8501
# Garde-fous Airflow pour un VPS partagé avec data-pipeline-mobility.
AIRFLOW_PARALLELISM=2
AIRFLOW_MAX_ACTIVE_TASKS_PER_DAG=1
LBA_API_KEY=
# Développement local : résultats LBA limités à 150 par source et département.
LBA_DEPARTMENTS=75,77,78,91,92,93,94,95
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
